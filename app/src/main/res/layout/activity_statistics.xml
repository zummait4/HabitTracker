<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/gradient_bg">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Назад"
        android:backgroundTint="#FF8C42"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Статистика привычек"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#5C3A21"
        android:background="#FFF5EE"
        android:padding="12dp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Прогресс за неделю"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#5C3A21"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:id="@+id/layoutWeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Дни пропусков"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#5C3A21"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvMissedDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Нет пропусков 👍"
        android:textColor="#5C3A21"
        android:textSize="14sp"
        android:background="#FFF5EE"
        android:padding="12dp"/>

</LinearLayout>